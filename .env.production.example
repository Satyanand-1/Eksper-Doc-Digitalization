# ==============================================================================
# EDRMS Production Environment Template (.env.production.example)
# SAFE TEMPLATE FOR PRODUCTION DEPLOYMENT
# STRICT REQUIREMENT: Replace all placeholder values marked "<GENERATE_...>"
# with cryptographically secure, production-grade credentials before deployment.
# NEVER commit or distribute the realized .env.production file.
# ==============================================================================

# Application Runtime Environment
ENVIRONMENT=production
NODE_ENV=production
LOG_LEVEL=info

# PostgreSQL Production Database Configuration
# Host should resolve to a dedicated production database server or private container
POSTGRES_HOST=db
POSTGRES_PORT=5432
POSTGRES_DB=edrms_prod_db
POSTGRES_USER=edrms_prod_user
# Production password must be at least 32 characters, random alphanumeric + special symbols
POSTGRES_PASSWORD=<GENERATE_SECURE_RANDOM_POSTGRES_PASSWORD_MIN_32_CHARS>

# Backend SQLAlchemy Database URL
DATABASE_URL=postgresql+psycopg2://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_DB}

# Storage Root Volume (Must be dedicated persistent volume with 0750 permissions)
STORAGE_ROOT=/var/edrms/storage
MAX_UPLOAD_SIZE_BYTES=26214400

# Cryptographic JWT Authentication Configuration
# Generate a cryptographically secure 64-character hex key via: openssl rand -hex 32
# Note: Pydantic Settings strictly rejects default dev keys or secrets < 32 characters
JWT_SECRET_KEY=<GENERATE_64_CHAR_HEX_SECRET_VIA_OPENSSL_RAND_HEX_32>
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15

# CORS Allowed Origins
# STRICT REQUIREMENT: Wildcard "*" is explicitly forbidden in production by backend validator.
# Provide a comma-separated list of explicit HTTPS origins.
ALLOWED_ORIGINS=https://edrms.example.gov,https://app.edrms.example.gov

# Durable OCR Background Worker Settings
OCR_WORKER_POLL_INTERVAL_SECONDS=2.0
OCR_WORKER_LEASE_SECONDS=60
OCR_WORKER_MAX_ATTEMPTS=3
OCR_WORKER_BASE_RETRY_DELAY_SECONDS=5
OCR_WORKER_BATCH_SIZE=5

# Database Connection Pool Settings
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_PRE_PING=true

# Frontend Configuration
FRONTEND_PORT=3000
BACKEND_PORT=8000
NEXT_PUBLIC_ENVIRONMENT=production
NEXT_PUBLIC_API_URL=https://edrms.example.gov

# Reverse Proxy & TLS Configuration (Reference for Nginx / Traefik / Caddy)
# DOMAIN_NAME=edrms.example.gov
# SSL_CERT_PATH=/etc/ssl/certs/edrms.crt
# SSL_KEY_PATH=/etc/ssl/private/edrms.key
