# EDRMS Environment Variables Template
# Copy this file to .env for local development

# PostgreSQL Configuration
POSTGRES_USER=edrms_user
POSTGRES_PASSWORD=edrms_secure_dev_password
POSTGRES_DB=edrms_db
POSTGRES_HOST=db
POSTGRES_PORT=5432

# Backend Configuration
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
ENVIRONMENT=development
LOG_LEVEL=info
DATABASE_URL=postgresql+psycopg2://edrms_user:edrms_secure_dev_password@db:5432/edrms_db
STORAGE_ROOT=/var/edrms/storage

# Upload Constraints (Default: 25 MB)
MAX_UPLOAD_SIZE_BYTES=26214400

# JWT Security Configuration
# In production, generate a secure random 256-bit key using: openssl rand -hex 32
JWT_SECRET_KEY=dev_insecure_jwt_secret_key_change_in_production_min_32_bytes_len
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15

# Frontend Configuration
FRONTEND_PORT=3000
NEXT_PUBLIC_API_URL=http://localhost:8000
