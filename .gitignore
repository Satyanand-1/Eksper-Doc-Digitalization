# Git Ignore for EDRMS Monorepo

# Environment and Secrets
.env
*.env
!.env.example
!.env.production.example

# Local storage, backups, and binary files
storage/uploads/*
storage/temp/*
!storage/uploads/.gitkeep
!storage/temp/.gitkeep
backups/
backups/*
!backups/.gitkeep
*.dump
*.sql
*.tar.gz

# Python / FastAPI
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
backend/venv/
backend/.venv/
env/
venv/
ENV/
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg
.pytest_cache/
.coverage
htmlcov/

# Node.js / Next.js
node_modules/
frontend/node_modules/
frontend/.next/
frontend/out/
*.tsbuildinfo
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# Database & Docker
postgres_data/
*.log

# OS & IDE
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
